datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Staff Accounts & Roles
enum UserRole {
  OWNER
  BILLING_OPERATOR
  ACCOUNTS_CHECKER
  WAREHOUSE_SUPERVISOR
  FIELD_REP
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  password     String
  role         UserRole  @default(BILLING_OPERATOR)
  phone        String?
  branch       String    @default("Central Logistics Warehouse")
  isActive     Boolean   @default(true)
  makerChecker Boolean   @default(false)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

// 2. Retail Chemist / Customer Master
enum CustomerStatus {
  ACTIVE
  BLOCKED
  WARNING
}

model Customer {
  id              String         @id @default(uuid())
  code            String         @unique // e.g. C-2041
  name            String
  type            String         @default("Retail Chemist")
  grade           String         @default("Grade A")
  route           String         @default("Route 3")
  salesman        String         @default("Ravi Kumar")
  address         String?
  phone           String?
  gstin           String
  gstinVerified   Boolean        @default(true)
  dlNumber        String         // DL 20B/21B
  dlValidTo       String         // e.g. 2028-12-31
  pharmacistOnRecord Boolean     @default(true)
  creditLimit     Float          @default(300000)
  creditUsed      Float          @default(0)
  termsDays       Int            @default(30)
  status          CustomerStatus @default(ACTIVE)
  blockReason     String?
  monthlyAvg      Float          @default(120000)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders          Order[]
  invoices        Invoice[]
  collections     Collection[]

  @@map("customers")
}

// 3. Products & Batch Inventory (FEFO)
model Product {
  id           String         @id @default(uuid())
  name         String
  principal    String         // e.g. Cipla, Sun Pharma, Abbott
  pack         String         // e.g. 10 strips, 1 pen, 100ml
  hsn          String         @default("30041010")
  gstPercent   Float          @default(12)
  mrp          Float
  ptr          Float          // Price to Retailer
  pts          Float          // Price to Stockist
  avgDailySale Float          @default(20)
  binLocation  String         @default("A-01-1")
  coldChain    Boolean        @default(false)
  scheduleH    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  batches      ProductBatch[]
  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]

  @@map("products")
}

model ProductBatch {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber String
  qty         Int      @default(0)
  expDate     String   // MM/YY or YYYY-MM
  status      String   @default("active") // active, push, quarantine, expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, batchNumber])
  @@map("product_batches")
}

// 4. Orders & Order Intake
enum OrderStatus {
  PENDING
  HOLD
  BILLED
  CANCELLED
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique // SO-2026-8812
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  customerName   String
  channel        String      @default("salesman") // salesman, app, whatsapp, counter
  channelLabel   String      @default("Salesman Beat")
  route          String      @default("Route 3")
  creditStatus   String      @default("Credit OK")
  creditBlocked  Boolean     @default(false)
  blockReason    String?
  orderTotal     Float
  status         OrderStatus @default(PENDING)
  irn            String?
  ewayBill       String?
  billedAt       String?
  schemeSummary  String?
  freeGoodsValue Float       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          OrderItem[]
  invoice        Invoice?

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  batch     String
  exp       String
  qty       Int
  free      String   @default("—")
  ptr       Float
  gst       Float    @default(12)
  amount    Float
  isShort   Boolean  @default(false)
  shortNote String?

  @@map("order_items")
}

// 5. Invoices & Billing
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum DispatchStatus {
  TRAY_ASSIGNED
  PACKED_AND_SEALED
  OUT_FOR_DELIVERY
  DELIVERED
}

model Invoice {
  id             String         @id @default(uuid())
  invoiceNo      String         @unique // INV-25-50388
  orderId        String?        @unique
  order          Order?         @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  customerName   String
  customerCode   String
  route          String
  gstin          String
  date           String
  time           String
  dueDate        String
  linesCount     Int            @default(1)
  taxable        Float
  gstAmount      Float
  total          Float
  irn            String         // 64-character NIC hash
  ewayBill       String?
  paymentStatus  PaymentStatus  @default(UNPAID)
  dispatchStatus DispatchStatus @default(TRAY_ASSIGNED)
  trayId         String         @default("Tray 14 · Bin C-04-2")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  hsn       String   @default("30041010")
  batch     String
  exp       String
  qty       Int
  free      String   @default("—")
  ptr       Float
  gst       Float    @default(12)
  total     Float

  @@map("invoice_items")
}

// 6. Warehouse Pick Waves
model WarehouseWave {
  id                  String   @id @default(uuid())
  trayId              String   @unique
  invoiceNo           String
  customerName        String
  linesCount          Int
  totalUnits          Int
  route               String
  vanAssigned         String
  weightKg            Float
  boxesCount          Int
  status              String   @default("picking") // picking, checking, sealed, dispatched
  isColdChainRequired Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items               PickWaveItem[]

  @@map("warehouse_waves")
}

model PickWaveItem {
  id           String        @id @default(uuid())
  waveId       String
  wave         WarehouseWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  binLocation  String
  productName  String
  pack         String
  billedBatch  String
  expiryDate   String
  qty          Int
  freeQty      String        @default("—")
  isColdChain  Boolean       @default(false)
  status       String        @default("pending") // picked, pending, mismatch
  scannedBatch String?
  mismatchNote String?

  @@map("pick_wave_items")
}

// 7. Delivery Routes & Drops
model DeliveryRoute {
  id              String         @id @default(uuid())
  routeNumber     String         @unique // Route 3
  driverName      String
  vanNumber       String
  totalDrops      Int            @default(0)
  deliveredDrops  Int            @default(0)
  totalOrderValue Float          @default(0)
  totalCollected  Float          @default(0)
  cashCollected   Float          @default(0)
  upiCollected    Float          @default(0)
  chequeCollected Float          @default(0)
  status          String         @default("on_route") // on_route, completed
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  drops           DeliveryDrop[]

  @@map("delivery_routes")
}

model DeliveryDrop {
  id               String        @id @default(uuid())
  routeId          String
  route            DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence         Int
  customerName     String
  customerCode     String
  address          String
  contactPerson    String
  phone            String
  invoiceNo        String
  boxesCount       Int
  invoiceAmount    Float
  oldDues          Float         @default(0)
  paymentMode      String        @default("Credit")
  returnPickUp     String?       // JSON or summary of returns
  otpVerified      Boolean       @default(false)
  photoTaken       Boolean       @default(false)
  signature        Boolean       @default(false)
  status           String        @default("pending") // pending, in_transit, delivered, failed
  collectedAmount  Float?
  collectionMethod String?
  deliveredAt      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("delivery_drops")
}

// 8. Collections & Receipts
model Collection {
  id                   String   @id @default(uuid())
  receiptNo            String   @unique // REC-25-8812
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id])
  customerName         String
  customerCode         String
  route                String
  collectorName        String
  collectorRole        String   @default("Delivery Driver")
  amount               Float
  mode                 String   @default("UPI QR") // UPI QR, Cheque, Bank NEFT, Cash
  referenceNo          String
  date                 String
  time                 String
  allocatedInvoices    String   // comma separated invoice numbers
  reconciliationStatus String   @default("Matched (Auto)") // Matched (Auto), Pending Bank Clearance, Disputed
  bankAccount          String   @default("HDFC Main Current A/c (9102)")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("collections")
}

// 9. Purchases & Supplier POs
model PurchaseOrder {
  id                String   @id @default(uuid())
  poNumber          String   @unique // PO-2026-9041
  principalName     String
  depotLocation     String
  orderDate         String
  expectedDate      String
  linesCount        Int
  totalPts          Float
  freeGoodsValue    Float    @default(0)
  schemeSlab        String?
  status            String   @default("transmitted") // transmitted, inwarding, received, discrepancy
  grnNumber         String?
  supplierInvoiceNo String?
  debitNoteNo       String?
  debitNoteAmount   Float?
  backOrdersWaiting Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  name            String
  pack            String
  orderedQty      Int
  freeQty         Int           @default(0)
  receivedQty     Int?
  ptsPrice        Float
  invoicedPts     Float?
  mrp             Float
  batchNo         String?
  expDate         String?
  isDiscrepancy   Boolean       @default(false)
  discrepancyNote String?

  @@map("purchase_order_items")
}

// 10. Principal Claims (Expiries & Damages)
model Claim {
  id                 String   @id @default(uuid())
  claimNo            String   @unique // CLM-25-0182
  type               String   // Expiry returns, Breakage / damage, Rate difference, Scheme reimbursement
  principalName      String
  cnfDepot           String
  amount             Float
  dateRaised         String
  ageDays            Int      @default(0)
  status             String   @default("Draft") // Draft, Sent to C&F, Verified, Credit Note Received
  creditNoteNo       String?
  creditNoteAmount   Float?
  evidenceFilesCount Int      @default(1)
  batchDetails       String
  linesCount         Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("claims")
}

// 11. Salesmen & Beat Visits
model Salesman {
  id                 String      @id @default(uuid())
  name               String
  phone              String
  email              String?
  beatName           String
  todayTarget        Float
  achievedAmount     Float       @default(0)
  todayOrdersBooked  Float       @default(0)
  todayCollections   Float       @default(0)
  totalVisits        Int         @default(0)
  completedVisits    Int         @default(0)
  status             String      @default("on_beat") // on_beat, completed, on_leave
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  visits             BeatVisit[]

  @@map("salesmen")
}

model BeatVisit {
  id               String   @id @default(uuid())
  salesmanId       String
  salesman         Salesman @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  sequence         Int
  customerName     String
  customerCode     String
  type             String   @default("Retail Chemist")
  distance         String   @default("1.2 km")
  status           String   @default("pending") // completed, in_progress, pending, skipped
  orderBooked      Float?
  collected        Float?
  dueAmount        Float    @default(0)
  usualOrderAmount Float    @default(0)
  gpsCheckedInAt   String?
  skipReason       String?
  licenceStatus    String   @default("valid")
  licenceNote      String?

  @@map("beat_visits")
}

// 12. Statutory Audit Logs
model AuditLog {
  id        String   @id @default(uuid())
  timestamp String
  user      String
  action    String
  module    String
  ipAddress String   @default("127.0.0.1")
  severity  String   @default("info") // info, warning, critical
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// 13. Company & Policy Master Settings
model CompanySetting {
  id                        String   @id @default("default")
  firmName                  String   @default("Shah Pharma Distributors LLP")
  tradeName                 String   @default("Shah Pharma (Central Logistics Hub)")
  dl20B                     String   @default("DL-20B-184920")
  dl21B                     String   @default("DL-21B-184921")
  dlExpiry                  String   @default("2028-11-30")
  fssaiNo                   String   @default("10020011000492")
  gstin                     String   @default("27AAAAA0000A1Z5")
  pharmacistName            String   @default("Rameshwar Nath Sharma, B.Pharm")
  pharmacistReg             String   @default("DPC-REG-449102")
  warehouseAddress          String   @default("Plot No. 44, Logistics Park, Bhiwandi, Maharashtra 421302")
  contactPhone              String   @default("+91 98200 12345")
  billingEmail              String   @default("billing@shahpharma.com")
  
  // Policies
  defaultCreditLimit        Float    @default(50000)
  defaultCreditDays         Int      @default(21)
  overdueBlockDays          Int      @default(45)
  requireMakerCheckerPin    Boolean  @default(true)
  nearExpiryAlertDays       Int      @default(90)
  strictFefoEnforced        Boolean  @default(true)
  minOrderValueFreeDelivery Float    @default(2500)

  // GST / Statutory Gateway
  gspProvider               String   @default("ClearTax / IRIS GST Enterprise")
  nicUsername               String   @default("PHARMA_EINV_27")
  nicClientId               String   @default("CLI-89304-NIC-PROD")
  autoEwbThreshold          Float    @default(50000)
  autoGenerateIrn           Boolean  @default(true)

  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())

  @@map("company_settings")
}

